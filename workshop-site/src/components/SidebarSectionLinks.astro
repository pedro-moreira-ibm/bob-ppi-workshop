---
interface SectionItem {
  slug: string;
  text: string;
  children: SectionItem[];
}
interface Props {
  items: SectionItem[];
  nested?: boolean;
}
const { items, nested = false } = Astro.props;
---

<ul class:list={{ nested }}>
  {items.map(item => (
    <li>
      <a href={`#${item.slug}`}>{item.text}</a>
      {item.children.length > 0 && <Astro.self items={item.children} nested />}
    </li>
  ))}
</ul>

<style>
  ul { list-style: none; margin: 0; padding: 0; }
  ul.nested { border-inline-start: 1px solid var(--sl-color-hairline-light); margin-inline-start: 0.45rem; padding-inline-start: 0.45rem; }
  li { margin: 0; padding: 0; }
  a {
    border-radius: 0.25rem;
    color: var(--sl-color-gray-2);
    display: block;
    font-size: var(--sl-text-xs);
    line-height: 1.3;
    padding: 0.32rem 0.35rem;
    text-decoration: none;
  }
  a:hover, a:focus, a[aria-current='true'] { color: var(--sl-color-text-accent); }
</style>
